        <mxCell id="offline" value="&lt;b&gt;Offline store&lt;/b&gt;&lt;br&gt;Delta time-series tables&lt;br&gt;&lt;font color=#6B7280&gt;every daily snapshot kept for PIT joins&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="620" y="150" width="210" height="100" as="geometry"/>
        </mxCell>
        <mxCell id="online" value="&lt;b&gt;Lakebase online store&lt;/b&gt;&lt;br&gt;7 published tables, one row per key&lt;br&gt;&lt;font color=#6B7280&gt;TRIGGERED + CONTINUOUS sync&lt;br&gt;cannot scale to zero&lt;/font&gt;" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;size=10;fillColor=#EDE9FE;strokeColor=#7C3AED;fontSize=11;strokeWidth=2;" vertex="1" parent="1">
          <mxGeometry x="620" y="420" width="210" height="110" as="geometry"/>
        </mxCell>
