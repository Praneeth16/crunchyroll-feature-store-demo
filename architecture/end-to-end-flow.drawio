        </mxCell>
        <mxCell id="trainCpu" value="&lt;b&gt;Train&lt;/b&gt; sklearn (driver)&lt;br&gt;or torch MLP on &lt;b&gt;serverless GPU&lt;/b&gt; (A10)&lt;br&gt;&lt;font color=#6B7280&gt;fe.log_model: feature spec travels with model&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="250" width="220" height="70" as="geometry"/>
        </mxCell>
