        </mxCell>
        <mxCell id="ftV" value="&lt;b&gt;Rail-grain feature tables&lt;/b&gt;&lt;br&gt;rail_features_ts · viewer_rail_features_ts&lt;br&gt;&lt;font color=#6B7280&gt;every lookup as-of (PIT) — V76 leak fix&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="1">
