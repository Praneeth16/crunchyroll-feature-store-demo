          <mxGeometry x="900" y="350" width="220" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="canary" value="&lt;b&gt;Canary gate&lt;/b&gt; (notebook 33, NEW)&lt;br&gt;90/10 split → per-entity error, p95, Spearman&lt;br&gt;&lt;b&gt;PROMOTE&lt;/b&gt; / &lt;b&gt;ROLLBACK&lt;/b&gt; → canary_decisions" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#059669;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="900" y="460" width="220" height="80" as="geometry"/>
