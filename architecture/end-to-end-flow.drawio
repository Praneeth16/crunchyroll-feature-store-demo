        <mxCell id="react" value="&lt;b&gt;React + Tailwind UI&lt;/b&gt;&lt;br&gt;&lt;font color=#6B7280&gt;one POST /api/homepage per view · stale requests aborted&lt;br&gt;waterfall · rails · watch-next · raw rows · fallback · freshness&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DC2626;strokeWidth=2;fontSize=11;" vertex="1" parent="1">
