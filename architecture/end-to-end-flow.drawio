        <mxCell id="ftH" value="&lt;b&gt;Shared feature tables&lt;/b&gt;&lt;br&gt;viewer_features · recent_behavior_ts&lt;br&gt;title_features · session_features&lt;br&gt;&lt;font color=#6B7280&gt;read by BOTH rankers&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#3B82F6;fontSize=11;" vertex="1" parent="1">
