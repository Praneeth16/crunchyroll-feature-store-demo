        <!-- 1 sources -->
        <mxCell id="events" value="&lt;b&gt;engagement_events&lt;/b&gt;&lt;br&gt;Delta, CDF on&lt;br&gt;&lt;font color=#6B7280&gt;107k events · impression, play, complete&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9CA3AF;fontSize=11;" vertex="1" parent="1">
