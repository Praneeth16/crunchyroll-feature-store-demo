        <mxCell id="title" value="&lt;b&gt;Crunchyroll homepage ranking on Databricks&lt;/b&gt; — two rankers, one feature store, batch and real-time from the same model" style="text;html=1;fontSize=20;fontColor=#1F2937;align=left;verticalAlign=middle;" vertex="1" parent="1">
