          <mxGeometry x="620" y="820" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- 4 train -->
        <mxCell id="ts" value="&lt;b&gt;fe.create_training_set&lt;/b&gt;&lt;br&gt;4 FeatureLookups (as-of) + 5 FeatureFunctions&lt;br&gt;&lt;font color=#6B7280&gt;IPS weights for position bias&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#10B981;fontSize=11;" vertex="1" parent="1">
