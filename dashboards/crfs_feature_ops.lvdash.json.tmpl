{
  "datasets": [
    {
      "name": "serving_latency",
      "displayName": "Serving latency and volume",
      "queryLines": [
        "SELECT date_trunc('hour', request_time) AS hour_bucket,\n",
        "       served_entity_id,\n",
        "       count(*) AS requests,\n",
        "       round(percentile_approx(execution_duration_ms, 0.5), 1)  AS p50_ms,\n",
        "       round(percentile_approx(execution_duration_ms, 0.95), 1) AS p95_ms,\n",
        "       round(percentile_approx(execution_duration_ms, 0.99), 1) AS p99_ms,\n",
        "       round(100.0 * sum(CASE WHEN status_code <> 200 THEN 1 ELSE 0 END) / count(*), 2) AS error_pct\n",
        "FROM __CATALOG__.__SCHEMA__.cr_ranker_inference_payload\n",
        "WHERE request_date >= current_date() - 14\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1 DESC\n"
      ]
    },
    {
      "name": "request_mix",
      "displayName": "What the application actually sends",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT databricks_request_id,\n",
        "         from_json(request, 'dataframe_records ARRAY<STRUCT<viewer_id STRING, title_id STRING, surface STRING, device STRING, locale STRING, hour_of_day INT>>') AS p\n",
        "  FROM __CATALOG__.__SCHEMA__.cr_ranker_inference_payload\n",
        "  WHERE request_date >= current_date() - 14)\n",
        "SELECT rec.surface, rec.device, rec.locale, rec.hour_of_day,\n",
        "       count(*) AS rows_scored,\n",
        "       count(DISTINCT databricks_request_id) AS requests\n",
        "FROM r LATERAL VIEW explode(r.p.dataframe_records) t AS rec\n",
        "GROUP BY 1, 2, 3, 4\n",
        "ORDER BY rows_scored DESC\n"
      ]
    },
    {
      "name": "score_by_genre",
      "displayName": "Score distribution by genre",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT databricks_request_id,\n",
        "         from_json(request,  'dataframe_records ARRAY<STRUCT<title_id STRING>>') AS req,\n",
        "         from_json(response, 'predictions ARRAY<DOUBLE>') AS res\n",
        "  FROM __CATALOG__.__SCHEMA__.cr_ranker_inference_payload\n",
        "  WHERE request_date >= current_date() - 14 AND status_code = 200),\n",
        "z AS (\n",
        "  SELECT req.dataframe_records[i].title_id AS title_id, res.predictions[i] AS score\n",
        "  FROM r LATERAL VIEW posexplode(res.predictions) p AS i, s)\n",
        "SELECT t.primary_genre,\n",
        "       count(*) AS scored,\n",
        "       round(avg(z.score), 4) AS mean_score,\n",
        "       round(max(z.score), 4) AS max_score\n",
        "FROM z JOIN __CATALOG__.__SCHEMA__.titles t ON t.title_id = z.title_id\n",
        "GROUP BY 1\n",
        "ORDER BY mean_score DESC\n"
      ]
    },
    {
      "name": "sync_health",
      "displayName": "Online table sync health",
      "queryLines": [
        "SELECT online_table,\n",
        "       max_by(detailed_state, captured_at) AS detailed_state,\n",
        "       max(captured_at) AS last_checked,\n",
        "       round(max_by(lag_seconds, captured_at), 1) AS lag_seconds,\n",
        "       max_by(delta_commit_version, captured_at) AS source_commit,\n",
        "       max_by(last_processed_commit_version, captured_at) AS processed_commit\n",
        "FROM __CATALOG__.__SCHEMA__.crfs_ops_sync_log\n",
        "GROUP BY 1\n",
        "ORDER BY 1\n"
      ]
    },
    {
      "name": "feature_freshness",
      "displayName": "Feature freshness",
      "queryLines": [
        "SELECT 'recent_behavior_current' AS feature_table,\n",
        "       count(*) AS rows,\n",
        "       round(max(last_event_epoch_s), 0) AS newest_event_epoch_s,\n",
        "       round((unix_timestamp(current_timestamp()) - max(last_event_epoch_s)) / 60.0, 1) AS newest_event_age_min\n",
        "FROM __CATALOG__.__SCHEMA__.recent_behavior_current\n",
        "UNION ALL\n",
        "SELECT 'engagement_events' AS feature_table,\n",
        "       count(*) AS rows,\n",
        "       round(max(unix_timestamp(event_ts)), 0) AS newest_event_epoch_s,\n",
        "       round((unix_timestamp(current_timestamp()) - max(unix_timestamp(event_ts))) / 60.0, 1) AS newest_event_age_min\n",
        "FROM __CATALOG__.__SCHEMA__.engagement_events\n"
      ]
    },
    {
      "name": "cost",
      "displayName": "Daily spend, list price",
      "queryLines": [
        "SELECT u.usage_date,\n",
        "       u.sku_name,\n",
        "       round(sum(u.usage_quantity), 2) AS dbu,\n",
        "       round(sum(u.usage_quantity * p.pricing.default), 2) AS usd_list\n",
        "FROM system.billing.usage u\n",
        "JOIN system.billing.list_prices p\n",
        "  ON u.sku_name = p.sku_name\n",
        " AND u.usage_end_time >= p.price_start_time\n",
        " AND (p.price_end_time IS NULL OR u.usage_end_time < p.price_end_time)\n",
        "WHERE (u.usage_metadata.endpoint_id = 'ep-wild-dawn-d2ao0nf7'\n",
        "    OR u.usage_metadata.endpoint_name LIKE 'crunchyroll-%')\n",
        "  AND u.usage_date >= current_date() - 14\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1 DESC, usd_list DESC\n"
      ]
    },
    {
      "name": "bench_ramp",
      "displayName": "Measured latency vs concurrency",
      "queryLines": [
        "-- One row per benchmark phase, written by notebooks/90_ops/25_serving_benchmark.py.\n",
        "-- `where` distinguishes an in-region job from a laptop; mixing them on one axis\n",
        "-- would be comparing the platform against somebody's wifi.\n",
        "SELECT concurrency,\n",
        "       `where`,\n",
        "       rows_per_request,\n",
        "       max(p50_ms) AS p50_ms,\n",
        "       max(p95_ms) AS p95_ms,\n",
        "       max(p99_ms) AS p99_ms,\n",
        "       max(rps)    AS requests_per_second,\n",
        "       sum(requests - ok) AS failed\n",
        "FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark\n",
        "WHERE phase = 'ramp'\n",
        "  AND measured_at >= (SELECT max(measured_at) - INTERVAL 1 DAY FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark)\n",
        "GROUP BY 1, 2, 3\n",
        "ORDER BY 2, 1\n"
      ]
    },
    {
      "name": "bench_fanout",
      "displayName": "Marginal cost of one more candidate rail",
      "queryLines": [
        "-- Latency against candidates per request at concurrency 1. Each additional rail is\n",
        "-- one more composite-key read against the online store inside the same call, so the\n",
        "-- slope of this is what a bigger homepage costs.\n",
        "SELECT rows_per_request AS candidate_rails,\n",
        "       endpoint,\n",
        "       max(p50_ms) AS p50_ms,\n",
        "       max(p95_ms) AS p95_ms,\n",
        "       round(max(p50_ms) / greatest(rows_per_request, 1), 2) AS p50_ms_per_rail\n",
        "FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark\n",
        "WHERE phase IN ('fanout', 'features_only')\n",
        "  AND measured_at >= (SELECT max(measured_at) - INTERVAL 1 DAY FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark)\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 2, 1\n"
      ]
    },
    {
      "name": "bench_spike",
      "displayName": "Traffic spike: baseline, spike, recovery",
      "queryLines": [
        "SELECT phase,\n",
        "       concurrency,\n",
        "       max(p50_ms) AS p50_ms,\n",
        "       max(p95_ms) AS p95_ms,\n",
        "       max(p99_ms) AS p99_ms,\n",
        "       max(rps)    AS requests_per_second,\n",
        "       sum(requests - ok) AS failed,\n",
        "       max(note)   AS note\n",
        "FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark\n",
        "WHERE phase LIKE 'spike%'\n",
        "  AND measured_at >= (SELECT max(measured_at) - INTERVAL 1 DAY FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark)\n",
        "GROUP BY 1, 2\n",
        "ORDER BY CASE phase WHEN 'spike_baseline' THEN 1 WHEN 'spike_load' THEN 2 ELSE 3 END\n"
      ]
    },
    {
      "name": "bench_config",
      "displayName": "The configuration these numbers belong to",
      "queryLines": [
        "-- A latency table without the endpoint configuration beside it is unfalsifiable:\n",
        "-- scale-to-zero, provisioned concurrency and route optimization each move the answer\n",
        "-- more than any model change would.\n",
        "SELECT max(measured_at) AS measured_at,\n",
        "       `where`,\n",
        "       endpoint,\n",
        "       get_json_object(max(endpoint_config_json), '$.route_optimized') AS route_optimized,\n",
        "       get_json_object(max(endpoint_config_json), '$.served_entities[0].scale_to_zero') AS scale_to_zero,\n",
        "       get_json_object(max(endpoint_config_json), '$.served_entities[0].min_provisioned_concurrency') AS min_concurrency,\n",
        "       get_json_object(max(endpoint_config_json), '$.served_entities[0].max_provisioned_concurrency') AS max_concurrency,\n",
        "       get_json_object(max(endpoint_config_json), '$.served_entities[0].workload_size') AS workload_size,\n",
        "       get_json_object(max(server_side_json), '$.p50_ms') AS server_p50_ms,\n",
        "       get_json_object(max(server_side_json), '$.p95_ms') AS server_p95_ms\n",
        "FROM __CATALOG__.__SCHEMA__.crfs_serving_benchmark\n",
        "GROUP BY 2, 3\n",
        "ORDER BY 1 DESC\n"
      ]
    },
    {
      "name": "rail_ranking_shift",
      "displayName": "How far the learned ranker moves each rail",
      "queryLines": [
        "-- The incumbent editorial order against the rail's measured engagement. A rail whose\n",
        "-- CTR rank is far from its editorial rank is one the current homepage is misplacing.\n",
        "SELECT r.rail_name,\n",
        "       r.rail_type,\n",
        "       r.editorial_rank,\n",
        "       rank() OVER (ORDER BY f.rail_ctr_30d DESC) AS ctr_rank,\n",
        "       r.editorial_rank - rank() OVER (ORDER BY f.rail_ctr_30d DESC) AS positions_misplaced,\n",
        "       round(f.rail_ctr_30d, 4)  AS rail_ctr_30d,\n",
        "       f.rail_impressions_30d,\n",
        "       round(f.rail_avg_watch_minutes_30d, 1) AS avg_watch_minutes\n",
        "FROM __CATALOG__.__SCHEMA__.rail_features f\n",
        "JOIN __CATALOG__.__SCHEMA__.rails r ON r.rail_id = f.rail_id\n",
        "ORDER BY r.editorial_rank\n"
      ]
    },
    {
      "name": "position_propensity",
      "displayName": "Position bias in the homepage log",
      "queryLines": [
        "-- The confound the vertical ranker has to correct for: P(viewport | position) measured\n",
        "-- from the log, and the inverse-propensity weight that undoes it.\n",
        "SELECT rail_position,\n",
        "       impressions,\n",
        "       p_view,\n",
        "       ips_weight\n",
        "FROM __CATALOG__.__SCHEMA__.rail_position_propensity\n",
        "ORDER BY rail_position\n"
      ]
    }
  ],
