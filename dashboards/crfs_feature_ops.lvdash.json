{
  "datasets": [
    {
      "name": "serving_latency",
      "displayName": "Serving latency and volume",
      "queryLines": [
        "SELECT date_trunc('hour', request_time) AS hour_bucket,\n",
        "       served_entity_id,\n",
        "       count(*) AS requests,\n",
        "       round(percentile_approx(execution_duration_ms, 0.5), 1)  AS p50_ms,\n",
        "       round(percentile_approx(execution_duration_ms, 0.95), 1) AS p95_ms,\n",
        "       round(percentile_approx(execution_duration_ms, 0.99), 1) AS p99_ms,\n",
        "       round(100.0 * sum(CASE WHEN status_code <> 200 THEN 1 ELSE 0 END) / count(*), 2) AS error_pct\n",
        "FROM serverless_lakebase_praneeth_catalog.crunchyroll_demo.cr_ranker_inference_payload\n",
        "WHERE request_date >= current_date() - 14\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1 DESC\n"
      ]
    },
    {
      "name": "request_mix",
      "displayName": "What the application actually sends",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT databricks_request_id,\n",
        "         from_json(request, 'dataframe_records ARRAY<STRUCT<viewer_id STRING, title_id STRING, surface STRING, device STRING, locale STRING, hour_of_day INT>>') AS p\n",
        "  FROM serverless_lakebase_praneeth_catalog.crunchyroll_demo.cr_ranker_inference_payload\n",
        "  WHERE request_date >= current_date() - 14)\n",
        "SELECT rec.surface, rec.device, rec.locale, rec.hour_of_day,\n",
        "       count(*) AS rows_scored,\n",
        "       count(DISTINCT databricks_request_id) AS requests\n",
        "FROM r LATERAL VIEW explode(r.p.dataframe_records) t AS rec\n",
        "GROUP BY 1, 2, 3, 4\n",
        "ORDER BY rows_scored DESC\n"
      ]
    },
    {
      "name": "score_by_genre",
      "displayName": "Score distribution by genre",
      "queryLines": [
        "WITH r AS (\n",
        "  SELECT databricks_request_id,\n",
        "         from_json(request,  'dataframe_records ARRAY<STRUCT<title_id STRING>>') AS req,\n",
        "         from_json(response, 'predictions ARRAY<DOUBLE>') AS res\n",
        "  FROM serverless_lakebase_praneeth_catalog.crunchyroll_demo.cr_ranker_inference_payload\n",
        "  WHERE request_date >= current_date() - 14 AND status_code = 200),\n",
        "z AS (\n",
        "  SELECT req.dataframe_records[i].title_id AS title_id, res.predictions[i] AS score\n",
        "  FROM r LATERAL VIEW posexplode(res.predictions) p AS i, s)\n",
        "SELECT t.primary_genre,\n",
        "       count(*) AS scored,\n",
        "       round(avg(z.score), 4) AS mean_score,\n",
        "       round(max(z.score), 4) AS max_score\n",
        "FROM z JOIN serverless_lakebase_praneeth_catalog.crunchyroll_demo.titles t ON t.title_id = z.title_id\n",
        "GROUP BY 1\n",
        "ORDER BY mean_score DESC\n"
      ]
    },
    {
      "name": "sync_health",
      "displayName": "Online table sync health",
      "queryLines": [
        "SELECT online_table,\n",
        "       max_by(detailed_state, captured_at) AS detailed_state,\n",
        "       max(captured_at) AS last_checked,\n",
        "       round(max_by(lag_seconds, captured_at), 1) AS lag_seconds,\n",
        "       max_by(delta_commit_version, captured_at) AS source_commit,\n",
        "       max_by(last_processed_commit_version, captured_at) AS processed_commit\n",
        "FROM serverless_lakebase_praneeth_catalog.crunchyroll_demo.crfs_ops_sync_log\n",
        "GROUP BY 1\n",
        "ORDER BY 1\n"
      ]
    },
    {
      "name": "feature_freshness",
      "displayName": "Feature freshness",
      "queryLines": [
        "SELECT 'recent_behavior_current' AS feature_table,\n",
        "       count(*) AS rows,\n",
        "       round(max(last_event_epoch_s), 0) AS newest_event_epoch_s,\n",
        "       round((unix_timestamp(current_timestamp()) - max(last_event_epoch_s)) / 60.0, 1) AS newest_event_age_min\n",
        "FROM serverless_lakebase_praneeth_catalog.crunchyroll_demo.recent_behavior_current\n",
        "UNION ALL\n",
        "SELECT 'engagement_events' AS feature_table,\n",
        "       count(*) AS rows,\n",
        "       round(max(unix_timestamp(event_ts)), 0) AS newest_event_epoch_s,\n",
        "       round((unix_timestamp(current_timestamp()) - max(unix_timestamp(event_ts))) / 60.0, 1) AS newest_event_age_min\n",
        "FROM serverless_lakebase_praneeth_catalog.crunchyroll_demo.engagement_events\n"
      ]
    },
    {
      "name": "cost",
      "displayName": "Daily spend, list price",
      "queryLines": [
        "SELECT u.usage_date,\n",
        "       u.sku_name,\n",
        "       round(sum(u.usage_quantity), 2) AS dbu,\n",
        "       round(sum(u.usage_quantity * p.pricing.default), 2) AS usd_list\n",
        "FROM system.billing.usage u\n",
        "JOIN system.billing.list_prices p\n",
        "  ON u.sku_name = p.sku_name\n",
        " AND u.usage_end_time >= p.price_start_time\n",
        " AND (p.price_end_time IS NULL OR u.usage_end_time < p.price_end_time)\n",
        "WHERE (u.usage_metadata.endpoint_id = 'ep-wild-dawn-d2ao0nf7'\n",
        "    OR u.usage_metadata.endpoint_name LIKE 'crunchyroll-%')\n",
        "  AND u.usage_date >= current_date() - 14\n",
        "GROUP BY 1, 2\n",
        "ORDER BY 1 DESC, usd_list DESC\n"
      ]
    }
  ],
